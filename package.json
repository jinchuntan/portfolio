{
  "name": "nigel-tan-portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Nigel Tan’s portfolio. Signals to impact across engineering, research and community.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs && node scripts/package.mjs",
    "check": "node scripts/build.mjs --check && node --check script.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "linkedom": "^0.18.13"
  }
}
